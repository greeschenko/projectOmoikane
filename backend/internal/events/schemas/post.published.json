{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org.omoikane.content.post.published.v1",
  "title": "Blog Post Published",
  "type": "object",
  "description": "Emitted by content-service when a blog post transitions to published.",
  "properties": {
    "id": { "type": "integer" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string", "const": "published" },
    "categoryId": { "type": ["integer", "null"] },
    "tagIds": { "type": "array", "items": { "type": "integer" } },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "slug", "title", "status", "publishedAt"]
}